# Docker Compose 环境变量模板：复制为 .env.docker 后填写
# cp .env.docker.example .env.docker

# ===== 数据库（容器内路径，由 compose 挂载持久卷）=====
DATABASE_URL="file:/app/data/prod.db"

# ===== AI 能力（至少配置一个供应商）=====
# DeepSeek（默认主供应商）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 通义千问（DashScope OpenAI 兼容模式）
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Moonshot / OpenAI（按需填写）
MOONSHOT_API_KEY=""
MOONSHOT_MODEL="moonshot-v1-8k"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 本地 Ollama（容器内需能访问；填写 BASE_URL 即启用）
# OLLAMA_BASE_URL="http://host.docker.internal:11434/v1"
OLLAMA_MODEL="qwen2.5:7b"

# 供应商优先级（逗号分隔，同时作为白名单；留空则按内置顺序尝试全部已配置供应商）
# AI_PROVIDER_ORDER="deepseek,qwen,moonshot,openai,ollama"
AI_DISABLE_FALLBACK="false"

# 外部联网搜索工具（可选，Tavily）
TAVILY_API_KEY=""

# ===== 认证（必改：生产环境使用随机长字符串）=====
# 生成示例：openssl rand -base64 48
JWT_SECRET="please-change-me-to-a-random-secret"

# ===== 演示数据（可选）=====
# 启动时自动创建演示用户 / 公开项目 / 评论，便于体验社区功能
SEED_DEMO_DATA="true"

# ===== 多模态视觉模型（可选，用于识别用户上传的参考图）=====
# 留空时若配置了通义千问 / OpenAI 密钥，会自动选择默认视觉模型；均无则降级
VISION_MODEL=""
VISION_BASE_URL=""
VISION_API_KEY=""
