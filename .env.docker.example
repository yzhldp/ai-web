# Docker Compose 环境变量模板：复制为 .env.docker 后填写
# cp .env.docker.example .env.docker

# ===== 数据库（容器内路径，由 compose 挂载持久卷）=====
DATABASE_URL="file:/app/data/prod.db"

# ===== AI 能力（必填）=====
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ===== 认证（必改：生产环境使用随机长字符串）=====
# 生成示例：openssl rand -base64 48
JWT_SECRET="please-change-me-to-a-random-secret"

# ===== 多模态视觉模型（可选，用于识别用户上传的参考图）=====
# 任意 OpenAI 兼容视觉模型；留空则参考图功能自动降级
VISION_MODEL=""
VISION_BASE_URL=""
VISION_API_KEY=""
