# ===== 数据库 =====
# SQLite 数据库文件路径（默认保存在 prisma 目录下）
DATABASE_URL="file:./dev.db"

# ===== AI 能力 =====
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=""
# DeepSeek API 基础地址（默认 OpenAI 兼容地址）
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 使用的模型（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL="deepseek-chat"

# ===== 认证 =====
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET="please-change-me-to-a-random-secret"
