# ===== 数据库 =====
# SQLite 数据库文件路径（默认保存在 prisma 目录下）
DATABASE_URL="file:./dev.db"

# ===== AI 能力 =====
# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=""
# DeepSeek API 基础地址（默认 OpenAI 兼容地址）
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 使用的模型（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL="deepseek-chat"

# ===== 多模态视觉模型（可选）=====
# 配置后，工作台支持上传界面截图 / 手绘草图并由视觉模型理解
# 需为 OpenAI 兼容接口；留空则自动降级为纯文本生成
VISION_MODEL=""
VISION_BASE_URL=""
VISION_API_KEY=""

# ===== 认证 =====
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET="please-change-me-to-a-random-secret"
