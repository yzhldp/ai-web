# ===== 数据库 =====
# SQLite 数据库文件路径（默认保存在 prisma 目录下）
DATABASE_URL="file:./dev.db"

# ===== AI 能力 =====
# 至少配置一个供应商即可运行；按顺序自动故障转移
# DeepSeek（默认主供应商）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 通义千问（DashScope OpenAI 兼容模式）
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Moonshot
MOONSHOT_API_KEY=""
MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
MOONSHOT_MODEL="moonshot-v1-8k"

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 本地 Ollama（填写 BASE_URL 即启用）
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5:7b"

# 供应商优先级（逗号分隔，同时作为白名单；留空则按内置顺序尝试全部已配置供应商）
# AI_PROVIDER_ORDER="deepseek,qwen,moonshot,openai,ollama"
# 关闭自动故障转移（仅使用第一个可用供应商）
AI_DISABLE_FALLBACK="false"

# ===== 多模态视觉模型（可选）=====
# 配置后，工作台支持上传界面截图 / 手绘草图并由视觉模型理解
# 需为 OpenAI 兼容接口；留空则自动降级为纯文本生成
VISION_MODEL=""
VISION_BASE_URL=""
VISION_API_KEY=""

# ===== 认证 =====
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET="please-change-me-to-a-random-secret"
