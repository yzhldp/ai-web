# ===== 数据库 =====
# SQLite 数据库文件路径（默认保存在 prisma 目录下）
DATABASE_URL="file:./dev.db"

# ===== AI 能力 =====
# 支持国内主流 OpenAI 兼容平台；至少配置一个供应商即可运行，按顺序自动故障转移
# 每个平台的 *_BASE_URL / *_MODEL 均可覆盖默认值

# DeepSeek（默认主供应商）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 通义千问（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# 智谱 GLM（GLM-4-Flash 免费）
ZHIPU_API_KEY=""
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_MODEL="glm-4-flash"

# Kimi（Moonshot）
MOONSHOT_API_KEY=""
MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
MOONSHOT_MODEL="moonshot-v1-8k"

# 豆包（火山方舟，模型可填推理接入点 ID）
DOUBAO_API_KEY=""
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_MODEL="doubao-1-5-pro-32k-250115"

# 文心一言（百度千帆）
QIANFAN_API_KEY=""
QIANFAN_BASE_URL="https://qianfan.baidubce.com/v2"
QIANFAN_MODEL="ernie-4.5-turbo-128k"

# 腾讯混元
HUNYUAN_API_KEY=""
HUNYUAN_BASE_URL="https://api.hunyuan.cloud.tencent.com/v1"
HUNYUAN_MODEL="hunyuan-turbos-latest"

# 讯飞星火
SPARK_API_KEY=""
SPARK_BASE_URL="https://spark-api-open.xf-yun.com/v1"
SPARK_MODEL="generalv3.5"

# MiniMax
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.chat/v1"
MINIMAX_MODEL="MiniMax-Text-01"

# 阶跃星辰
STEPFUN_API_KEY=""
STEPFUN_BASE_URL="https://api.stepfun.com/v1"
STEPFUN_MODEL="step-2-16k"

# 零一万物
YI_API_KEY=""
YI_BASE_URL="https://api.lingyiwanwu.com/v1"
YI_MODEL="yi-lightning"

# 百川智能
BAICHUAN_API_KEY=""
BAICHUAN_BASE_URL="https://api.baichuan-ai.com/v1"
BAICHUAN_MODEL="Baichuan4"

# 商汤日日新
SENSENOVA_API_KEY=""
SENSENOVA_BASE_URL="https://api.sensenova.cn/compatible-mode/v1"
SENSENOVA_MODEL="SenseChat-5"

# 硅基流动（聚合平台，可调用多种开源模型）
SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL="deepseek-ai/DeepSeek-V3"

# 自定义 OpenAI 兼容平台（必须填写 BASE_URL）
CUSTOM_API_KEY=""
CUSTOM_BASE_URL=""
CUSTOM_MODEL=""

# 本地 Ollama（填写 BASE_URL 即启用，无需 API Key）
OLLAMA_BASE_URL=""
OLLAMA_MODEL="qwen2.5:7b"

# 供应商优先级（逗号分隔，同时作为白名单；留空则按内置顺序尝试全部已配置供应商）
# AI_PROVIDER_ORDER="deepseek,qwen,zhipu,moonshot,doubao,qianfan,hunyuan,spark,minimax,stepfun,yi,baichuan,sensenova,siliconflow,custom,ollama"
# 关闭自动故障转移（仅使用第一个可用供应商）
AI_DISABLE_FALLBACK="false"
# 流式生成首 Token 超时（毫秒，超过后自动切换下一家）
AI_FIRST_TOKEN_TIMEOUT_MS="20000"

# ===== 运行配置（可选）=====
# 服务端口（next start 使用）
PORT="3000"
# Docker 数据目录（仅容器入口使用，本地开发无需填写）
# DATA_DIR="/app/data"

# 外部联网搜索工具（可选，Tavily）
TAVILY_API_KEY=""

# ===== 多模态视觉模型（可选）=====
# 配置后，工作台支持上传界面截图 / 手绘草图并由视觉模型理解
# 留空时若配置了通义千问 / 智谱 GLM 密钥，会自动选择默认视觉模型；均无则降级为纯文本
VISION_MODEL=""
VISION_BASE_URL=""
VISION_API_KEY=""

# ===== 认证 =====
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET="please-change-me-to-a-random-secret"

# ===== 演示数据 =====
# 启动时自动创建演示用户、公开项目与评论（设为 false 可关闭）
SEED_DEMO_DATA="true"

# ===== MCP Server =====
# 可选：外部 MCP 客户端调用 /api/mcp 的 API Key；留空时使用站内登录会话鉴权
MCP_API_KEY=""
