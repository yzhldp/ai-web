// 创意雏形合成助手 - 数据模型定义
// 使用 SQLite 单文件数据库，无需额外服务

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户表
model User {
  id        String   @id @default(cuid())
  username  String   @unique // 账号（唯一，1-20位）
  password  String // 密码哈希（bcryptjs 加密）
  nickname  String? // 昵称（可选）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans     ProjectPlan[]
  comments  Comment[]
  auditLogs AiAuditLog[]
}

/// 项目方案表
model ProjectPlan {
  id        String   @id @default(cuid())
  userId    String // 关联用户
  mode      String // 类型：tool / business
  painPoint String // 痛点输入
  demand    String // 需求输入
  idea      String // 奇思妙想输入
  content   String // AI 生成的完整方案内容
  // ===== AI 技术补齐新增字段（JSON 字符串，兼容 SQLite）=====
  analysis  String? // 需求解析结构化结果
  sources   String? // RAG 检索来源与得分
  quality   String? // 方案质检报告
  diagram   String? // Mermaid 架构图源码
  hasImage  Boolean @default(false) // 是否使用了多模态参考图
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
}

/// 评论表
model Comment {
  id        String   @id @default(cuid())
  planId    String // 关联方案
  userId    String // 评论用户
  content   String // 评论内容
  createdAt DateTime @default(now())

  plan ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// AI 调用审计表
model AiAuditLog {
  id             String   @id @default(cuid())
  userId         String
  action         String // generate / iterate / assistant / agent
  mode           String? // tool / business
  success        Boolean  @default(true)
  safetyFlags    String   @default("") // 安全标记，逗号分隔
  retrievalCount Int      @default(0) // RAG 命中条数
  toolCalls      Int      @default(0) // 工具调用次数
  inputChars     Int      @default(0)
  latencyMs      Int      @default(0)
  totalTokens    Int      @default(0)
  preview        String? // 脱敏后的输入摘要
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
